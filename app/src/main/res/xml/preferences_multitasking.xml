<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/fork_gestures">
        <SwitchPreferenceCompat
            android:key="fork_bar_swipes"
            android:title="@string/fork_bar_swipes_title"
            android:summary="@string/fork_bar_swipes_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="fork_icon_swipes"
            android:title="@string/fork_icon_swipes_title"
            android:summary="@string/fork_icon_swipes_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="fork_icon_swipe_close"
            android:title="@string/fork_icon_swipe_close_title"
            android:summary="@string/fork_icon_swipe_close_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="fork_haptics"
            android:title="@string/fork_haptics_title"
            android:summary="@string/fork_haptics_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="fork_double_tap_swap"
            android:title="@string/fork_double_tap_swap_title"
            android:summary="@string/fork_double_tap_swap_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/fork_windows">
        <SwitchPreferenceCompat
            android:key="fork_empty_half"
            android:title="@string/fork_empty_half_title"
            android:summary="@string/fork_empty_half_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="fork_hide_paired"
            android:title="@string/fork_hide_paired_title"
            android:summary="@string/fork_hide_paired_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="fork_keyboard_mode"
            android:title="@string/fork_keyboard_mode_title"
            android:entries="@array/fork_keyboard_modes"
            android:entryValues="@array/fork_keyboard_mode_values"
            android:defaultValue="above"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="fork_shrink_while_typing"
            android:title="@string/fork_shrink_while_typing_title"
            android:summary="@string/fork_shrink_while_typing_summary"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="fork_typing_lift"
            android:title="@string/fork_typing_lift_title"
            android:summary="@string/fork_typing_lift_summary"
            android:max="160"
            app:min="0"
            app:showSeekBarValue="true"
            android:defaultValue="0" />
        <cu.axel.smartdock.preferences.AppChooserMultiplePreference
            android:key="fork_hidden_apps"
            android:title="@string/fork_hidden_apps_title"
            android:summary="@string/fork_hidden_apps_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/fork_troubleshooting">
        <SwitchPreferenceCompat
            android:key="fork_debug_keyboard"
            android:title="@string/fork_debug_keyboard_title"
            android:summary="@string/fork_debug_keyboard_summary"
            android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
