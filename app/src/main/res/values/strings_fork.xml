<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for features added in the astambl fork (English only) -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="fork_multitasking">Multitasking</string>
    <string name="fork_gestures">Gestures</string>
    <string name="fork_windows">Windows and pairs</string>
    <string name="fork_bar_swipes_title">Swipe on dock to snap</string>
    <string name="fork_bar_swipes_summary">Swipe left or right on an empty part of the dock to snap the active window to that half, or up to toggle full screen. When off, swiping left goes back</string>
    <string name="fork_icon_swipes_title">Swipe on app icons</string>
    <string name="fork_icon_swipes_summary">Swipe left, right or up on an app icon to snap that app or toggle full screen</string>
    <string name="fork_icon_swipe_close_title">Swipe down on icon to close</string>
    <string name="fork_icon_swipe_close_summary">Swipe down on an app icon to close its window. On a pair icon, closes both apps</string>
    <string name="fork_double_tap_swap_title">Double tap to swap sides</string>
    <string name="fork_double_tap_swap_summary">Double tap an empty part of the dock to swap the left and right windows. Double tap a pair icon to swap its apps</string>
    <string name="fork_empty_half_title">Open new apps in the empty half</string>
    <string name="fork_empty_half_summary">With a half-screen launch mode, new apps open in the half the current window isn\'t using</string>
    <string name="fork_hide_paired_title">Hide apps that are in a pair</string>
    <string name="fork_hide_paired_summary">Paired apps are shown only through their pair icon, including their open windows</string>
    <string name="fork_hide_from_dock">Hide from dock</string>
    <string name="fork_hidden_apps_title">Hidden apps</string>
    <string name="fork_hidden_apps_summary">Apps that never appear on the dock, even while open. Gestures ignore them too</string>
    <string name="fork_haptics_title">Vibrate on gestures</string>
    <string name="fork_haptics_summary">A short vibration confirms when a swipe or double tap is recognised</string>
    <string name="fork_keyboard_mode_title">When the keyboard opens</string>
    <string name="fork_keyboard_mode_above">Move dock above the keyboard</string>
    <string name="fork_keyboard_mode_hide">Hide the dock</string>
    <string name="fork_keyboard_mode_top">Keep dock where it is (covers keyboard)</string>
    <string-array name="fork_keyboard_modes">
        <item>@string/fork_keyboard_mode_above</item>
        <item>@string/fork_keyboard_mode_hide</item>
        <item>@string/fork_keyboard_mode_top</item>
    </string-array>
    <string-array name="fork_keyboard_mode_values" translatable="false">
        <item>above</item>
        <item>hide</item>
        <item>top</item>
    </string-array>
    <string name="fork_troubleshooting">Troubleshooting</string>
    <string name="fork_debug_keyboard_title">Show keyboard diagnostics</string>
    <string name="fork_debug_keyboard_summary">Shows what SmartDock detects about the keyboard at the top of the screen</string>
</resources>
